{
  "name": "meshcentral-mcp-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/main.js",
    "test": "node --test",
