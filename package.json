  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.1.0",
    "ws": "8.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
